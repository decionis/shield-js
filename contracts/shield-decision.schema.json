{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decionis.com/schemas/shield/decision-v1.json",
  "title": "Shield spending decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "allowed",
    "approvalRequired",
    "approvalStatus",
    "reason",
    "reasonCode",
    "requestId",
    "decisionId",
    "dossierId",
    "environment"
  ],
  "properties": {
    "verdict": { "type": "string", "enum": ["ALLOW", "ASK", "BLOCK"] },
    "allowed": { "type": "boolean" },
    "approvalRequired": { "type": "boolean" },
    "approvalStatus": {
      "type": "string",
      "enum": ["NOT_REQUIRED", "PENDING", "APPROVED", "DENIED", "EXPIRED"]
    },
    "reason": { "type": "string" },
    "reasonCode": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "requestId": { "type": "string", "pattern": "^shr_[A-Za-z0-9_-]+$" },
    "decisionId": { "type": "string", "pattern": "^dec_[A-Za-z0-9_-]+$" },
    "dossierId": { "type": "string", "pattern": "^dsr_[A-Za-z0-9_-]+$" },
    "environment": { "type": "string", "enum": ["sandbox", "production"] },
    "advanced": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "ALLOW" } } },
      "then": {
        "properties": {
          "allowed": { "const": true },
          "approvalRequired": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "ASK" } } },
      "then": {
        "properties": {
          "allowed": { "const": false },
          "approvalRequired": { "const": true }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "BLOCK" } } },
      "then": {
        "properties": {
          "allowed": { "const": false },
          "approvalRequired": { "const": false }
        }
      }
    }
  ]
}
